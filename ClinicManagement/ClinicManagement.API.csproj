<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Data\SeedData\Appointments.json" />
    <Content Remove="Data\SeedData\Departments.json" />
    <Content Remove="Data\SeedData\Doctors.json" />
    <Content Remove="Data\SeedData\Patients.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\SeedData\Appointments.json" />
    <None Include="Data\SeedData\Departments.json" />
    <None Include="Data\SeedData\Doctors.json" />
    <None Include="Data\SeedData\Patients.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClinicManagement.Application\ClinicManagement.Application.csproj" />
    <ProjectReference Include="..\ClinicManagement.infrastructure\ClinicManagement.Infrastructure.csproj" />
  </ItemGroup>

	<ItemGroup>
		<None Update="Data\SeedData\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
